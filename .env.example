# ==============================================================================
# MI VITAE — Variables de Entorno para Producción & Cloudflare Pages
# ==============================================================================

# 1. Supabase Cloud (PostgreSQL + Auth)
# Obtén estos valores en: https://app.supabase.com/project/_/settings/api
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Clave privada para Cloudflare Functions (Solo en servidor / Cloudflare Secrets)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Pasarela de Pagos Flow.cl (Chile)
# Obtén tus credenciales en https://www.flow.cl (o sandbox.flow.cl)
FLOW_API_KEY=tu_api_key_flow
FLOW_SECRET_KEY=tu_secret_key_flow
FLOW_SANDBOX=false # Cambiar a true si pruebas en sandbox.flow.cl

# 3. Correos Transaccionales con Resend API
# Obtén tu API Key en https://resend.com/api-keys
RESEND_API_KEY=re_123456789...
RESEND_FROM_EMAIL="Mi Vitae <contacto@wearesamod.com>"

# 4. Configuración de Dominio y Producción
APP_URL=https://mi-vitae.wearesamod.com
ENVIRONMENT=production

# 5. Cloudflare R2 (Opcional para avatares en bucket propio)
# R2_PUBLIC_DOMAIN=https://assets.wearesamod.com
